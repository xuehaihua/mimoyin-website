# Generic fallback: any *.html old permalink to directory form
RewriteCond %{REQUEST_URI} !^/(breathability-waterproof-calculator|google[0-9a-f]+)\.html$
RewriteRule ^(.+)\.html$ /$1/ [R=301,L]

# Force HTTPS and canonical www
RewriteCond %{HTTP_HOST} !^www\.mimoyin\.com$ [NC]
RewriteRule ^(.*)$ https://www.mimoyin.com/$1 [R=301,L]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://www.mimoyin.com/$1 [R=301,L]
